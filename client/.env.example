# Environment switch: development | staging | production
NODE_ENV=development
VITE_APP_ENV=development

# Backend API URL (include /api/v1)
# Local development: http://localhost:8080/api/v1
# Staging / production: https://atomictask.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Example overrides:
# VITE_APP_ENV=staging
# VITE_API_BASE_URL=https://atomictask.onrender.com/api/v1
# VITE_APP_ENV=production
# VITE_API_BASE_URL=https://atomictask.onrender.com/api/v1
